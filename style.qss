QMainWindow, QWidget {
    background-color: #1c1c1e;
    color: #ffffff;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

QMenuBar {
    background-color: #1c1c1e;
    color: #ffffff;
    border-bottom: 1px solid #3a3a3c;
    padding: 4px;
}

QMenuBar::item:selected {
    background-color: #fc3c44;
    color: #ffffff;
    border-radius: 4px;
}

QMenu {
    background-color: #2c2c2e;
    color: #ffffff;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #fc3c44;
    color: #ffffff;
    border-radius: 4px;
}

QLineEdit {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #fc3c44;
}

QTreeWidget {
    background-color: #1c1c1e;
    color: #ffffff;
    border: none;
    outline: none;
}

QTreeWidget::item {
    padding: 8px;
    border-radius: 4px;
    margin: 1px 4px;
    color: #ffffff;
}

QTreeWidget::item:selected {
    background-color: #fc3c44;
    color: #ffffff;
}

QTreeWidget::item:hover {
    background-color: #2c2c2e;
    color: #ffffff;
}

QPushButton {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #fc3c44;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #d63030;
}

QLabel {
    color: #aeaeb2;
    font-size: 13px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #fc3c44;
}

QComboBox {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}

QComboBox:focus {
    border: 1px solid #fc3c44;
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    color: #ffffff;
    border: 1px solid #3a3a3c;
    border-radius: 4px;
    selection-background-color: #fc3c44;
    selection-color: #ffffff;
}

QComboBox::drop-down {
    border: none;
}

QTextEdit {
    background-color: #2c2c2e;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px;
}

QTextEdit:focus {
    border: 1px solid #fc3c44;
}

QScrollBar:vertical {
    background-color: #1c1c1e;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3c;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #fc3c44;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QSplitter::handle {
    background-color: #3a3a3c;
    width: 1px;
}

QGraphicsView {
    background-color: #2c2c2e;
    border: none;
    border-radius: 8px;
}

QStatusBar {
    background-color: #2c2c2e;
    color: #aeaeb2;
    font-size: 12px;
    padding: 4px;
}
